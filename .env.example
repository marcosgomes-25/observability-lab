# Copie para .env e ajuste:  cp .env.example .env
# O .env nao e versionado (.gitignore).

# Banco do Zabbix (definido no 1o start; trocar depois exige recriar o volume pgdata)
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=zabbix

# Admin do Grafana (aplicado no 1o start; depois altere pela UI)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=troque-esta-senha

# Usuario da API do Zabbix usado pelo datasource do Grafana e pelo zabbix/setup-tempconv.sh.
# O Zabbix sobe com Admin/zabbix: troque a senha na UI (User settings > Profile) e repita aqui.
ZABBIX_API_USER=Admin
ZABBIX_API_PASSWORD=zabbix
